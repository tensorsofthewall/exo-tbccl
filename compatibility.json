{
  "schema_version": 1,
  "project": "exo-tbccl",
  "release_assets": [
    "exo_tbccl-{version}-cp313-cp313-manylinux_2_24_x86_64.manylinux_2_28_x86_64.whl",
    "exo_tbccl-{version}-cp313-cp313-macosx_14_0_arm64.whl"
  ],
  "package": {
    "development_version": "0.4.0",
    "release_candidate": false,
    "target_release": "0.4.0",
    "released": true,
    "note": "0.4.0 is a minor release of 0.3.1: it bundles TBCCL 0.7.0 and adds opt-in Metal options (EXO_TBCCL_PREALLOC_GATHER and a CPU-stream option for the borrow views) and decode-timeline diagnostics; every default is unchanged. The tbccl extra of the immutable tbccl-integration-v2 fork tag still resolves to the 0.3.0 wheel; the 0.4.0 wheel is installed by hand over it."
  },
  "python": {
    "requires": ">=3.13"
  },
  "frameworks": {
    "mlx": {
      "validated": [
        "0.32.0 (linux cuda)",
        "0.32.4.dev20261013+0e3ff3643 (macos, exo's pin)",
        "0.32.0.dev20261004+cc3f3e60 (macos, earlier pin)"
      ]
    },
    "exo": {
      "integration": "the TBCCL integration series (PipelineComm seam, MlxTbccl placement, runner byte exchange) published as an immutable signed tag of the maintained exo fork",
      "fork": "tensorsofthewall/exo-fork",
      "fork_tag": "tbccl-integration-v2",
      "fork_revision": "d1497b28b89618172d273e70e9ac7992811635f5",
      "upstream_base": "bc412e2230f395e652c23426a5eb88dfa515769b",
      "upstream_base_date": "2026-10-13",
      "install": "uv sync --no-dev --locked --extra mlx-cuda13 --extra tbccl (Linux) or --extra mlx --extra tbccl (macOS), in a checkout of the tag",
      "legacy_integration": {
        "fork_tag": "tbccl-integration-v1",
        "fork_revision": "1416807b46efd87c3601c69ce5784f51c9dd4c75",
        "upstream_base": "75d8ad2bc1eac25aaf7adb39c0784ad0def8c1b6",
        "upstream_base_date": "2026-10-12",
        "install": "tag checkout plus an exo-tbccl 0.3.x wheel installed manually (no optional extra)"
      }
    }
  },
  "requires_tbccl": {
    "c_abi": [
      1
    ],
    "minimum_package": "0.6.0"
  },
  "platforms": [
    {
      "os": "linux",
      "arch": "x86_64",
      "devices": [
        "cuda",
        "cpu"
      ]
    },
    {
      "os": "macos",
      "arch": "arm64",
      "devices": [
        "metal",
        "cpu"
      ]
    }
  ],
  "validated_configurations": [
    {
      "name": "loopback-qwen3-0.6b-8bit",
      "stages": 2,
      "model": "Qwen3-0.6B-8bit",
      "mlx_metal": "0.32.4.dev20261013+0e3ff3643"
    },
    {
      "name": "thunderbolt-real-exo-rebased-qwen3-0.6b-8bit",
      "stages": [
        "macos-metal",
        "linux-cuda"
      ],
      "model": "Qwen3-0.6B-8bit",
      "tbccl_wire_protocol": 4,
      "exo_upstream_base": "75d8ad2bc1eac25aaf7adb39c0784ad0def8c1b6",
      "layer_splits": [
        "21/7",
        "7/21"
      ],
      "cycles": 3
    },
    {
      "name": "thunderbolt-real-exo-rebased-qwen3.8-27b-4bit",
      "stages": [
        "macos-metal",
        "linux-cuda"
      ],
      "model": "Qwen3.8-27B-4bit",
      "tbccl_wire_protocol": 4,
      "orientations": [
        "mac-rank0",
        "linux-rank0"
      ],
      "memory_override_mb": {
        "linux": 5200,
        "mac": 10800
      }
    },
    {
      "name": "thunderbolt-real-exo-v2-qwen3-0.6b-8bit",
      "stages": [
        "macos-metal",
        "linux-cuda"
      ],
      "model": "Qwen3-0.6B-8bit",
      "tbccl_wire_protocol": 4,
      "exo_fork_tag": "tbccl-integration-v2",
      "exo_fork_revision": "d1497b28b89618172d273e70e9ac7992811635f5",
      "install": "optional tbccl extra",
      "layer_splits": [
        "7/21"
      ],
      "cycles": 1
    }
  ]
}
